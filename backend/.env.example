# Firestore 인증 (로컬 개발: 서비스 계정 json 파일 경로)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Render 배포 시에는 위 대신 아래에 서비스 계정 JSON 전체를 문자열로 넣기
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", ...}

# OpenAI-compatible API (Codyssey 공개 API 사용 시 문서 탭의 Base URL 입력)
OPENAI_API_KEY=발급받은_API_키
OPENAI_BASE_URL=https://copa.codyssey.kr
OPENAI_MODEL=gpt-5-mini

# 배포 시 Vercel 프론트엔드 도메인으로 설정 (쉼표로 여러 origin 입력 가능)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
